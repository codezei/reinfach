    //-         source(srcset=`img/${category}-after-mob.png` media="(max-width: 430px)")
    //-         source(type="image/webp" srcset=`img/${category}-after.webp`)
    //-         img(src=`img/${category}-after.png` alt=altAfter)&attributes(attributes)
