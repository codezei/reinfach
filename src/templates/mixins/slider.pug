mixin slider(category, altBefore = "", altAfter = "")
    .beer-slider-wrapper
        .beer-slider(id=`${category}-slider` data-beer-label="Nachher→")
            img(src=`img/process/${category}-after.png` alt=altAfter)&attributes(attributes)
            .beer-reveal(data-beer-label="←Vorher")
                img(src=`img/process/${category}-before.png` alt=altBefore)&attributes(attributes)
