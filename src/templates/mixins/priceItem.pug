mixin priceItem(category)
    .price-item.col
        h3.h4.price-item__title= category.title
        .price-item__table
            table.price-table
                each item in category.items
                    tr.price-table__row
                        td.w-100
                            .price-table__name
                                img(src=`img/${item.icon}` alt="" width="100" height="66" loading="lazy")
                                p= item.name
                        td
                            .price-table__value.text-accent ab #[span.h3.text-bold= item.price]&nbsp;€
        .price-item__footer
            .btn-row
                +btn(category.btnText)(class="btn-primary btn-normal magnet-btn flex-grow-1")
                a.btn.btn-normal.btn-white.magnet-btn.flex-shrink-0(href=`tel:${phoneNumber}`)
                    span.btn-icon
                        svg(width="24" height="24")
                            use(href="#tel")
