mixin priceItem(category)
    .price-item.col
        h3.price-item__title= category.title
        .price-item__table
            table.price-table
                each item in category.items
                    tr.price-table__row
                        td.w-100
                            .price-table__name
                                img(src=`img/${item.icon}`, alt="", width="100")
                                p= item.name
                        td
                            .price-table__value.text-accent ab #[span.h3.text-bold= item.price]&nbsp;€
        .price-item__footer
            +btn(category.btnText)(class="btn-primary btn-large magnet-btn w-100")
