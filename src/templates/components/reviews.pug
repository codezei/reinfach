section#reviews.reviews.section.section-secondary(data-nav="reviews")
    .container.custom-container
        .section__header
            .section__header-col
                .pre-title.section__header-pre-title Kundenstimmen & Feedback
                h2.title.section__header-title #[span.text-accent Echte Erfahrungen] aus Würzburg & Umgebung
            .section__header-col
                p.subtitle.subtitle-extractor-right.section__header-subtitle Überzeugen Sie sich von unserer Arbeitsqualität: Das berichten Privat- und Geschäftskunden über unsere mobile Polster-, Matratzen- und Auto-Innenreinigung direkt vor Ort.
        .section__body
            .card.card-white.card-normal.card-rounded.card-shadow.card-grid
                .card.card-grid.h-100
                    .card__header
                        svg(width="64" height="64")
                            use(href="#google")
                        div
                            .card__rating.rating(style="--star-rating: 5;")
                            div 5,0 von 5 Sternen · 100 % Weiterempfehlung
                            a.card__link.text-link(href=google target="_blank" rel="noopener noreferrer") Alle Rezensionen auf Google ansehen&nbsp;↗

                .swiper.reviews-swiper
                    .swiper-wrapper
                        each review in reviewData
                            .swiper-slide.h-auto
                                +reviewItem(review)
        .section__footer
            .swiper-navigation
                button.btn.btn-secondary.btn-normal.btn-shadow.reviews-navigation-button-prev(type="button")
                    span.btn-icon
                        svg(width="16" height="16")
                            use(href="#chevron-left")
                .swiper-pagination.reviews-pagination.swiper-pagination-static.w-auto
                button.btn.btn-secondary.btn-normal.btn-shadow.reviews-navigation-button-next(type="button")
                    span.btn-icon
                        svg(width="16" height="16")
                            use(href="#chevron-right")
