header.header.section.section-white
    .header__inner
        .header__logo
            include logo
        .header__menu#main-menu
            nav.menu.menu-row(aria-label="Hauptnavigation")
                a.menu__item(href="#services" data-tilt data-link="services") Leistungen
                a.menu__item(href="#price" data-tilt data-link="price") Preise
                a.menu__item(href="#works" data-tilt data-link="works") Vorher / Nachher
                a.menu__item(href="#reviews" data-tilt data-link="reviews") Bewertungen
                a.menu__item(href="#contacts" data-tilt data-link="contacts") Kontakt
            .header__menu-btn.text-center
                include socials
        .header__burger
            button.js-burger.btn.btn-clear.btn-flush#burger(type="button" aria-label="Menü öffnen" aria-expanded="false" aria-controls="mobile-widget")
                span.sr-only Menü öffnen
                span.cross(aria-hidden="true")
                    span
                    span
                    span
        .header__widget.widget#mobile-widget
            .widget__header
                include logo
            .widget__body
                nav.menu.menu-column.widget__menu(aria-label="Mobile Navigation")
                    a.menu__item(href="#services" data-link="services") Leistungen
                    a.menu__item(href="#price" data-link="price") Preise
                    a.menu__item(href="#works" data-link="works") Vorher / Nachher
                    a.menu__item(href="#reviews" data-link="reviews") Bewertungen
                    a.menu__item(href="#contacts" data-link="contacts") Kontakt
            .widget__footer
                include socials
