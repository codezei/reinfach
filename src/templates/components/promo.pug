                //-         .bullet__icon
                //-             img(src="img/service-salon.png" alt="")
                //-         .bullet__text Autositze & Innenräume
            .promo-grid__footer
                .promo__buttons
                    +btn('Foto senden & Festpreis erhalten')(class="btn-primary btn-large magnet-btn")
