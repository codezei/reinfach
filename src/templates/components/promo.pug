
section.promo#promo.section.section-secondary.section-full-height(data-nav="promo")
    .container.section__body.custom-container
        .promo-grid
            .promo-grid__header
                .card
                    .card__header
                        svg(width="48" height="48" aria-hidden="true")
                            use(href="#google")
                        div
                            .card__rating.rating(style="--star-rating: 5;" aria-hidden="true")
                            a.card__link.text-link(href=google target="_blank" rel="noopener noreferrer") 5,0 ★ Bewertungen auf Google Maps&nbsp;↗

                h1.promo__title.title #[span.text-accent Professionelle Polsterreinigung] in Würzburg vor Ort

                .custom-cta.promo__custom-cta
                    p.custom-cta__subtitle.h4 Fasertiefe Reinheit für Ihr Sofa (Couch), Matratzen, Teppiche und Autositze – direkt bei Ihnen zu Hause (0 € Anfahrt in Würzburg).
                    img.custom-cta__img(
                        src="img/master.webp"
                        alt="ReinFach Fachmann für mobile Polsterreinigung in Würzburg"
                        width="200"
                        height="300"
                        fetchpriority="high"
                    )
                    .custom-cta__row
                        a.custom-cta__btn.btn.btn-primary.btn-large.btn-shadow(
                            href=whatsappLink
                            target="_blank"
                            rel="noopener noreferrer"
                        )
                            span.btn-icon.pulse(aria-hidden="true")
                                svg(width="24" height="24")
                                    use(href="#whatsapp")
                            span.btn-text Foto senden & Preis erhalten
                        a.custom-cta__tel.btn.btn-white.btn-large.magnet-btn.flex-shrink-0.btn-shadow(`tel:${phoneNumber}`)
                            span.btn-icon(aria-hidden="true")
                                svg(width="24" height="24")
                                    use(href="#tel")


            .promo-grid__body
                .tabs(data-tabs)
                    .tabs__nav(role="tablist" aria-label="Vorher-Nachher Beispiele")
                        button.tabs__btn.is-active#tab-sofas(
                            type="button"
                            role="tab"
                            aria-selected="true"
                            aria-controls="pane-sofas"
                            data-tabs-target="sofas"
                        ) Sofas & Couches

                        button.tabs__btn#tab-matratzen(
                            type="button"
                            role="tab"
                            aria-selected="false"
                            aria-controls="pane-matratzen"
                            data-tabs-target="matratzen"
                        ) Matratzen

                        button.tabs__btn#tab-autositze(
                            type="button"
                            role="tab"
                            aria-selected="false"
                            aria-controls="pane-autositze"
                            data-tabs-target="autositze"
                        ) Autositze

                    .tabs__body
                        .tabs__pane.is-active#pane-sofas(
                            role="tabpanel"
                            aria-labelledby="tab-sofas"
                            data-tabs-pane="sofas"
                        )
                            +ba-slider({
                                before: 'img/process/sofa-before.webp',
                                after: 'img/process/sofa-after.webp',
                                altBefore: 'Stark verschmutztes Sofa vor der Polsterreinigung in Würzburg',
                                altAfter: 'Sauberes Sofa nach der fasertiefen Polsterreinigung vor Ort'
                            })(fetchpriority="hight", loading="eager")

                        .tabs__pane#pane-matratzen(
                            role="tabpanel"
                            aria-labelledby="tab-matratzen"
                            data-tabs-pane="matratzen"
                        )
                            +ba-slider({
                                before: 'img/process/mattress-before.webp',
                                after: 'img/process/mattress-after.webp',
                                altBefore: 'Matratze mit Flecken vor der Matratzenreinigung',
                                altAfter: 'Hygienisch reine Matratze nach der Tiefenreinigung'
                            })(loading="lazy")

                        .tabs__pane#pane-autositze(
                            role="tabpanel"
                            aria-labelledby="tab-autositze"
                            data-tabs-pane="autositze"
                        )
                            +ba-slider({
                                before: 'img/process/salon-before.webp',
                                after: 'img/process/salon-after.webp',
                                altBefore: 'Autositz mit Flecken vor der Auto-Innenreinigung',
                                altAfter: 'Sauberer Autositz nach der Polsteraufbereitung'
                            })(loading="lazy")
