        //- Особливість блоку: інтерактивна плашка швидкого старту Кроку 01
        .section__footer
            .row.row-cols-lg-2.justify-content-between.align-items-center
                div
                    //- span.how__cta-pulse
                    strong Bereit für Schritt 01?
                    |  Antwortzeit per WhatsApp in der Regel unter #[span.text-accent 15 Minuten].
                div
                    .btn-row
                        +btn('Jetzt Foto per WhatsApp senden')(class="btn-primary btn-normal magnet-btn flex-grow-1")
                        a.btn.btn-normal.btn-white.magnet-btn.flex-shrink-0(href=`tel:${phoneNumber}`)
                            span.btn-icon
                                svg(width="24" height="24")
                                    use(href="#tel")
